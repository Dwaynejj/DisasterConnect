/* DisasterConnect Main Stylesheet */

QMainWindow, QDialog {{
    background-color: {BG_APP};
    color: {TEXT_PRIMARY};
}}

QWidget {{
    color: {TEXT_PRIMARY};
}}

/* Primary Button */
QPushButton.primary {{
    background-color: {PRIMARY};
    color: white;
    border-radius: 6px;
    border: none;
    height: 36px;
    font-weight: bold;
}}
QPushButton.primary:hover {{
    background-color: {PRIMARY_DARK};
}}
QPushButton.primary:pressed {{
    background-color: {PRIMARY_DARK};
}}

/* Danger Button */
QPushButton.danger {{
    background-color: {ACCENT_RED};
    color: white;
    border-radius: 6px;
    border: none;
    height: 36px;
    font-weight: bold;
}}
QPushButton.danger:hover {{
    background-color: #C0392B;
}}

/* Ghost Button */
QPushButton.ghost {{
    background-color: transparent;
    color: {PRIMARY};
    border: 1px solid {PRIMARY};
    border-radius: 6px;
    height: 36px;
    font-weight: bold;
}}
QPushButton.ghost:hover {{
    background-color: rgba(31, 111, 235, 0.1);
}}

/* Inputs */
QLineEdit, QTextEdit, QComboBox {{
    background-color: {BG_SURFACE};
    color: {TEXT_PRIMARY};
    border: 1px solid {BORDER};
    border-radius: 6px;
    height: 36px;
    padding-left: 8px;
}}
QLineEdit:focus, QTextEdit:focus, QComboBox:focus {{
    border: 2px solid {PRIMARY};
}}

/* QTableWidget */
QTableWidget {{
    background-color: {BG_SURFACE};
    color: {TEXT_PRIMARY};
    alternate-background-color: #F8F9FA;
    border: 1px solid {BORDER};
    border-radius: 8px;
    gridline-color: transparent;
}}
QHeaderView::section {{
    background-color: #F3F4F6;
    color: {TEXT_SECONDARY};
    font-weight: bold;
    border: none;
    border-bottom: 2px solid {BORDER};
    padding: 8px;
}}

/* Vertical Scrollbar */
QScrollBar:vertical {{
    background-color: transparent;
    width: 6px;
    margin: 0px 0px 0px 0px;
}}
QScrollBar::handle:vertical {{
    background-color: #CBD5E1;
    min-height: 20px;
    border-radius: 3px;
}}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {{
    height: 0px;
}}

/* QTabWidget */
QTabWidget::pane {{
    border: none;
}}
QTabBar::tab {{
    background: transparent;
    color: {TEXT_SECONDARY};
    padding: 8px 16px;
}}
QTabBar::tab:selected {{
    color: {PRIMARY};
    border-bottom: 2px solid {PRIMARY};
    font-weight: bold;
}}

/* QCheckBox */
QCheckBox {{
    spacing: 8px;
    color: {TEXT_PRIMARY};
}}
QCheckBox::indicator {{
    width: 18px;
    height: 18px;
    border: 1px solid {BORDER};
    border-radius: 4px;
    background: {BG_SURFACE};
}}
QCheckBox::indicator:checked {{
    background-color: {PRIMARY};
    border: 1px solid {PRIMARY};
    image: url("src/styles/icons/check.svg");
}}

/* QComboBox Dropdown */
QComboBox::drop-down {{
    border: none;
    width: 30px;
}}
QComboBox::down-arrow {{
    image: url("src/styles/icons/arrow-down.svg");
}}

/* QToolTip */
QToolTip {{
    background-color: #1A1A2E;
    color: white;
    border: none;
    border-radius: 4px;
    padding: 4px 8px;
}}

/* QProgressBar */
QProgressBar {{
    background-color: {BORDER};
    border: none;
    border-radius: 2px;
    height: 4px;
    text-align: center;
    color: transparent;
}}
QProgressBar::chunk {{
    background-color: {SUCCESS};
    border-radius: 2px;
}}
